{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infinite-spacetime.local/schemas/passage.schema.json",
  "title": "Passage",
  "type": "object",
  "required": ["id", "source", "sequence", "text", "revision"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": [
        "workId",
        "editionId",
        "volumeId",
        "volumeLabel",
        "passageId"
      ],
      "properties": {
        "workId": { "type": "string" },
        "editionId": { "type": "string" },
        "volumeId": { "type": "string" },
        "volumeLabel": { "type": "string" },
        "sectionLabel": { "type": "string" },
        "pageId": { "type": "string" },
        "passageId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sequence": { "type": "integer", "minimum": 0 },
    "text": {
      "type": "object",
      "required": ["original"],
      "properties": {
        "original": { "type": "string" },
        "simplified": { "type": "string" },
        "modernTranslation": { "type": "string" }
      },
      "additionalProperties": false
    },
    "facsimile": {
      "type": "object",
      "required": ["pageId"],
      "properties": {
        "pageId": { "type": "string", "minLength": 1 },
        "canvasUrl": { "type": "string", "format": "uri" },
        "imageUrl": { "type": "string", "format": "uri" },
        "region": {
          "type": "array",
          "prefixItems": [
            { "type": "number" },
            { "type": "number" },
            { "type": "number", "minimum": 0 },
            { "type": "number", "minimum": 0 }
          ],
          "items": false
        }
      },
      "additionalProperties": false
    },
    "revision": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
