{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infinite-spacetime.org/schemas/0.7.0/publication.schema.json",
  "title": "KnowledgePublication",
  "description": "Canonical portable publication contract for Infinite SpatioTemporal Map.",
  "type": "object",
  "required": [
    "manifest",
    "sources",
    "works",
    "editions",
    "volumes",
    "facsimilePages",
    "passages",
    "passageAlignments",
    "entities",
    "mentions",
    "assertions",
    "places",
    "geometries",
    "occurrences"
  ],
  "properties": {
    "manifest": { "$ref": "#/definitions/PublicationManifest" },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/definitions/SourceRecord" }
    },
    "works": {
      "type": "array",
      "items": { "$ref": "#/definitions/Work" }
    },
    "editions": {
      "type": "array",
      "items": { "$ref": "#/definitions/Edition" }
    },
    "volumes": {
      "type": "array",
      "items": { "$ref": "#/definitions/Volume" }
    },
    "facsimilePages": {
      "type": "array",
      "items": { "$ref": "#/definitions/FacsimilePage" }
    },
    "passages": {
      "type": "array",
      "items": { "$ref": "#/definitions/Passage" }
    },
    "passageAlignments": {
      "type": "array",
      "items": { "$ref": "#/definitions/PassageAlignment" }
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/definitions/Entity" }
    },
    "mentions": {
      "type": "array",
      "items": { "$ref": "#/definitions/Mention" }
    },
    "assertions": {
      "type": "array",
      "items": { "$ref": "#/definitions/Assertion" }
    },
    "places": {
      "type": "array",
      "items": { "$ref": "#/definitions/PlaceIdentity" }
    },
    "geometries": {
      "type": "array",
      "items": { "$ref": "#/definitions/HistoricalGeometry" }
    },
    "occurrences": {
      "type": "array",
      "items": { "$ref": "#/definitions/SpatiotemporalOccurrence" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Id": {
      "title": "WireId",
      "type": "string",
      "minLength": 1
    },
    "NonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "Uri": {
      "type": "string",
      "format": "uri"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Checksum": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ReviewStatus": {
      "title": "ReviewStatus",
      "enum": [
        "raw",
        "machine_suggested",
        "reviewed",
        "verified",
        "disputed",
        "rejected"
      ]
    },
    "EditorialReviewStatus": {
      "title": "EditorialReviewStatus",
      "enum": ["reviewed", "verified", "disputed"]
    },
    "PredicateId": {
      "title": "PredicateId",
      "enum": [
        "family.parent_of",
        "family.child_of",
        "family.spouse_of",
        "family.sibling_of",
        "family.clan_member_of",
        "education.teacher_of",
        "education.student_of",
        "education.affiliated_with",
        "office.held_position",
        "office.held_title",
        "office.served_at",
        "office.rank",
        "social.friend_of",
        "social.associated_with",
        "place.native_place",
        "place.resided_at",
        "event.participated_in",
        "heritage.creator",
        "heritage.material",
        "heritage.technique",
        "heritage.motif",
        "heritage.inscription",
        "heritage.collection",
        "heritage.public_name",
        "heritage.catalogue_number",
        "society.population",
        "society.households",
        "society.taxation",
        "society.local_product",
        "society.tribute_product",
        "society.custom",
        "event.kind",
        "classification.member_of",
        "descriptive.note",
        "other.related_to"
      ]
    },
    "TemporalValue": {
      "title": "TemporalValue",
      "type": "object",
      "required": ["original", "certainty"],
      "properties": {
        "original": { "$ref": "#/definitions/NonEmptyString" },
        "startYear": { "type": "integer" },
        "startMonth": { "type": "integer", "minimum": 1, "maximum": 12 },
        "startDay": { "type": "integer", "minimum": 1, "maximum": 31 },
        "endYear": { "type": "integer" },
        "endMonth": { "type": "integer", "minimum": 1, "maximum": 12 },
        "endDay": { "type": "integer", "minimum": 1, "maximum": 31 },
        "certainty": {
          "enum": ["exact", "approximate", "range", "unknown"]
        },
        "calendar": { "$ref": "#/definitions/NonEmptyString" }
      },
      "dependentRequired": {
        "startMonth": ["startYear"],
        "startDay": ["startYear", "startMonth"],
        "endMonth": ["endYear"],
        "endDay": ["endYear", "endMonth"]
      },
      "additionalProperties": false
    },
    "EvidenceSpan": {
      "title": "EvidenceSpan",
      "type": "object",
      "required": ["passageId", "start", "end"],
      "properties": {
        "passageId": { "$ref": "#/definitions/Id" },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 },
        "note": { "$ref": "#/definitions/NonEmptyString" }
      },
      "additionalProperties": false
    },
    "SourceRef": {
      "title": "SourceRef",
      "type": "object",
      "required": ["sourceId"],
      "properties": {
        "sourceId": { "$ref": "#/definitions/Id" },
        "locator": { "$ref": "#/definitions/NonEmptyString" },
        "note": { "$ref": "#/definitions/NonEmptyString" }
      },
      "additionalProperties": false
    },
    "PublicationManifest": {
      "title": "PublicationManifest",
      "type": "object",
      "required": [
        "contractVersion",
        "publicationId",
        "datasetVersion",
        "title",
        "generatedAt",
        "contentChecksum",
        "sourceDescription"
      ],
      "properties": {
        "contractVersion": { "const": "0.7.0" },
        "publicationId": { "$ref": "#/definitions/Id" },
        "datasetVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
        },
        "title": { "$ref": "#/definitions/NonEmptyString" },
        "generatedAt": { "$ref": "#/definitions/Timestamp" },
        "contentChecksum": { "$ref": "#/definitions/Checksum" },
        "sourceDescription": { "$ref": "#/definitions/NonEmptyString" }
      },
      "additionalProperties": false
    },
    "SourceRecord": {
      "title": "SourceRecord",
      "type": "object",
      "required": ["id", "kind", "title", "rightsStatement"],
      "properties": {
        "id": { "$ref": "#/definitions/Id" },
        "kind": {
          "enum": [
            "facsimile",
            "transcription",
            "catalogue",
            "gis",
            "dataset",
            "bibliography",
            "other"
          ]
        },
        "title": { "$ref": "#/definitions/NonEmptyString" },
        "holdingInstitution": { "$ref": "#/definitions/NonEmptyString" },
        "url": { "$ref": "#/definitions/Uri" },
        "rightsStatement": { "$ref": "#/definitions/NonEmptyString" },
        "checksum": { "$ref": "#/definitions/Checksum" },
        "accessedAt": { "$ref": "#/definitions/Timestamp" }
      },
      "additionalProperties": false
    },
    "WorkCoverage": {
      "title": "WorkCoverage",
      "type": "object",
      "required": ["regionLabels", "placeIds"],
      "properties": {
        "temporal": { "$ref": "#/definitions/TemporalValue" },
        "regionLabels": {
          "type": "array",
          "items": { "$ref": "#/definitions/NonEmptyString" },
          "uniqueItems": true
        },
        "placeIds": {
          "type": "array",
          "items": { "$ref": "#/definitions/Id" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "Work": {
      "title": "Work",
      "type": "object",
      "required": [
        "id",
        "title",
        "alternativeTitles",
        "category",
        "sourceRefs"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/Id" },
        "title": { "$ref": "#/definitions/NonEmptyString" },
        "alternativeTitles": {
          "type": "array",
          "items": { "$ref": "#/definitions/NonEmptyString" },
          "uniqueItems": true
        },
        "category": {
          "enum": ["gazetteer", "history", "genealogy", "catalogue", "other"]
        },
        "abstract": { "$ref": "#/definitions/NonEmptyString" },
        "coverage": { "$ref": "#/definitions/WorkCoverage" },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/SourceRef" }
        }
      },
      "additionalProperties": false
    },
    "Edition": {
      "title": "Edition",
      "type": "object",
      "required": ["id", "workId", "label", "sourceRefs"],
      "properties": {
        "id": { "$ref": "#/definitions/Id" },
        "workId": { "$ref": "#/definitions/Id" },
        "label": { "$ref": "#/definitions/NonEmptyString" },
        "publicationStatement": { "$ref": "#/definitions/NonEmptyString" },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/SourceRef" }
        }
      },
      "additionalProperties": false
    },
    "Volume": {
      "title": "Volume",
      "type": "object",
      "required": ["id", "editionId", "label", "sequence"],
      "properties": {
        "id": { "$ref": "#/definitions/Id" },
        "editionId": { "$ref": "#/definitions/Id" },
        "parentVolumeId": { "$ref": "#/definitions/Id" },
        "label": { "$ref": "#/definitions/NonEmptyString" },
        "sequence": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "FacsimilePage": {
      "title": "FacsimilePage",
      "type": "object",
      "required": ["id", "volumeId", "sourceId", "sequence"],
      "properties": {
        "id": { "$ref": "#/definitions/Id" },
        "volumeId": { "$ref": "#/definitions/Id" },
        "sourceId": { "$ref": "#/definitions/Id" },
        "label": { "$ref": "#/definitions/NonEmptyString" },
        "sequence": { "type": "integer", "minimum": 0 },
        "canvasUrl": { "$ref": "#/definitions/Uri" },
        "imageUrl": { "$ref": "#/definitions/Uri" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "TextLayers": {
      "title": "TextLayers",
      "type": "object",
      "required": ["original"],
      "properties": {
        "original": { "type": "string" },
        "simplified": { "type": "string" },
        "punctuated": { "type": "string" },
        "modernTranslation": { "type": "string" }
      },
      "additionalProperties": false
    },
    "FacsimileAnchor": {
      "title": "FacsimileAnchor",
      "type": "object",
      "required": ["pageId"],
      "properties": {
        "pageId": { "$ref": "#/definitions/Id" },
        "region": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number", "minimum": 0 }
        }
      },
      "additionalProperties": false
    },
    "Passage": {
      "title": "Passage",
      "type": "object",
      "required": [
        "id",
        "volumeId",
        "sequence",
        "text",
        "facsimileAnchors",
        "revision"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/Id" },
        "volumeId": { "$ref": "#/definitions/Id" },
        "sectionLabel": { "$ref": "#/definitions/NonEmptyString" },
        "sequence": { "type": "integer", "minimum": 0 },
        "text": { "$ref": "#/definitions/TextLayers" },
        "facsimileAnchors": {
          "type": "array",
          "items": { "$ref": "#/definitions/FacsimileAnchor" }
        },
        "revision": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "PassageAlignmentMember": {
      "title": "PassageAlignmentMember",
      "type": "object",
      "required": ["editionId", "passageIds"],
      "properties": {
        "editionId": { "$ref": "#/definitions/Id" },
        "passageIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/Id" }
        }
      },
      "additionalProperties": false
    },
    "PassageAlignment": {
      "title": "PassageAlignment",
      "type": "object",
      "required": [
        "id",
        "workId",
        "relation",
        "members",
        "reviewStatus",
        "reviewedBy",
        "reviewedAt",
        "revision"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/Id" },
        "workId": { "$ref": "#/definitions/Id" },
        "relation": {
          "enum": ["equivalent", "partial_overlap", "reordered", "uncertain"]
        },
        "members": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/definitions/PassageAlignmentMember" }
        },
        "reviewStatus": {
          "$ref": "#/definitions/EditorialReviewStatus"
        },
        "reviewedBy": { "$ref": "#/definitions/NonEmptyString" },
        "reviewedAt": { "$ref": "#/definitions/Timestamp" },
        "note": { "$ref": "#/definitions/NonEmptyString" },
        "revision": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "EntityType": {
      "title": "EntityType",
      "enum": [
        "person",
        "place",
        "time",
        "office",
        "institution",
        "event",
        "artifact",
        "site",
        "material",
        "technique",
        "motif",
        "inscription"
      ]
    },
    "Entity": {
      "title": "Entity",
      "type": "object",
      "required": ["id", "type", "preferredName", "aliases", "reviewStatus"],
      "properties": {
        "id": { "$ref": "#/definitions/Id" },
        "type": { "$ref": "#/definitions/EntityType" },
        "preferredName": { "$ref": "#/definitions/NonEmptyString" },
        "aliases": {
          "type": "array",
          "items": { "$ref": "#/definitions/NonEmptyString" },
          "uniqueItems": true
        },
        "summary": { "$ref": "#/definitions/NonEmptyString" },
        "reviewStatus": { "$ref": "#/definitions/ReviewStatus" }
      },
      "additionalProperties": false
    },
    "Mention": {
      "title": "Mention",
      "type": "object",
      "required": [
        "id",
        "passageId",
        "entityId",
        "start",
        "end",
        "surface",
        "reviewStatus"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/Id" },
        "passageId": { "$ref": "#/definitions/Id" },
        "entityId": { "$ref": "#/definitions/Id" },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 },
        "surface": { "$ref": "#/definitions/NonEmptyString" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reviewStatus": { "$ref": "#/definitions/ReviewStatus" }
      },
      "additionalProperties": false
    },
    "Assertion": {
      "title": "Assertion",
      "oneOf": [
        { "$ref": "#/definitions/EntityAssertion" },
        { "$ref": "#/definitions/LiteralAssertion" }
      ]
    },
    "EntityAssertion": {
      "title": "EntityAssertion",
      "type": "object",
      "required": [
        "id",
        "subjectId",
        "predicate",
        "objectId",
        "evidence",
        "reviewStatus"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/Id" },
        "subjectId": { "$ref": "#/definitions/Id" },
        "predicate": { "$ref": "#/definitions/PredicateId" },
        "objectId": { "$ref": "#/definitions/Id" },
        "temporal": { "$ref": "#/definitions/TemporalValue" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/EvidenceSpan" }
        },
        "reviewStatus": { "$ref": "#/definitions/ReviewStatus" }
      },
      "additionalProperties": false
    },
    "LiteralAssertion": {
      "title": "LiteralAssertion",
      "type": "object",
      "required": [
        "id",
        "subjectId",
        "predicate",
        "literalValue",
        "evidence",
        "reviewStatus"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/Id" },
        "subjectId": { "$ref": "#/definitions/Id" },
        "predicate": { "$ref": "#/definitions/PredicateId" },
        "literalValue": { "type": "string" },
        "temporal": { "$ref": "#/definitions/TemporalValue" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/EvidenceSpan" }
        },
        "reviewStatus": { "$ref": "#/definitions/ReviewStatus" }
      },
      "additionalProperties": false
    },
    "HistoricalName": {
      "title": "HistoricalName",
      "type": "object",
      "required": ["name", "evidence", "sourceRefs"],
      "properties": {
        "name": { "$ref": "#/definitions/NonEmptyString" },
        "validDuring": { "$ref": "#/definitions/TemporalValue" },
        "kind": { "$ref": "#/definitions/NonEmptyString" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/definitions/EvidenceSpan" }
        },
        "sourceRefs": {
          "type": "array",
          "items": { "$ref": "#/definitions/SourceRef" }
        }
      },
      "additionalProperties": false
    },
    "PlaceIdentity": {
      "title": "PlaceIdentity",
      "type": "object",
      "required": ["id", "entityId", "historicalNames", "parentPlaceIds"],
      "properties": {
        "id": { "$ref": "#/definitions/Id" },
        "entityId": { "$ref": "#/definitions/Id" },
        "historicalNames": {
          "type": "array",
          "items": { "$ref": "#/definitions/HistoricalName" }
        },
        "parentPlaceIds": {
          "type": "array",
          "items": { "$ref": "#/definitions/Id" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "Position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number" }
    },
    "LinearRing": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/definitions/Position" }
    },
    "PolygonCoordinates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/LinearRing" }
    },
    "GeoPoint": {
      "title": "GeoPoint",
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "Point" },
        "coordinates": { "$ref": "#/definitions/Position" }
      },
      "additionalProperties": false
    },
    "GeoPolygon": {
      "title": "GeoPolygon",
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "Polygon" },
        "coordinates": { "$ref": "#/definitions/PolygonCoordinates" }
      },
      "additionalProperties": false
    },
    "GeoMultiPolygon": {
      "title": "GeoMultiPolygon",
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "MultiPolygon" },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/PolygonCoordinates" }
        }
      },
      "additionalProperties": false
    },
    "HistoricalGeometry": {
      "title": "HistoricalGeometry",
      "type": "object",
      "required": [
        "id",
        "placeId",
        "geometry",
        "precision",
        "sourceRefs",
        "reviewStatus"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/Id" },
        "placeId": { "$ref": "#/definitions/Id" },
        "geometry": {
          "oneOf": [
            { "$ref": "#/definitions/GeoPoint" },
            { "$ref": "#/definitions/GeoPolygon" },
            { "$ref": "#/definitions/GeoMultiPolygon" }
          ]
        },
        "validDuring": { "$ref": "#/definitions/TemporalValue" },
        "precision": { "enum": ["site", "settlement", "region", "unknown"] },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/SourceRef" }
        },
        "reviewStatus": { "$ref": "#/definitions/ReviewStatus" }
      },
      "additionalProperties": false
    },
    "OccurrenceKind": {
      "title": "OccurrenceKind",
      "enum": [
        "birth",
        "death",
        "native_place",
        "residence",
        "office",
        "journey",
        "event",
        "creation",
        "discovery",
        "collection",
        "other"
      ]
    },
    "SpatiotemporalOccurrence": {
      "title": "SpatiotemporalOccurrence",
      "type": "object",
      "required": [
        "id",
        "entityId",
        "placeId",
        "kind",
        "evidence",
        "reviewStatus"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/Id" },
        "entityId": { "$ref": "#/definitions/Id" },
        "placeId": { "$ref": "#/definitions/Id" },
        "kind": { "$ref": "#/definitions/OccurrenceKind" },
        "label": { "$ref": "#/definitions/NonEmptyString" },
        "temporal": { "$ref": "#/definitions/TemporalValue" },
        "sequence": { "type": "integer", "minimum": 0 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/EvidenceSpan" }
        },
        "reviewStatus": { "$ref": "#/definitions/ReviewStatus" }
      },
      "additionalProperties": false
    }
  }
}
